APP_NAME=Laravel
APP_ENV=local
APP_VERSION="0.0.1"
APP_KEY=
APP_DEBUG=true
APP_HTTP_DOMAIN=localhost
APP_URL=http://${APP_HTTP_DOMAIN}
APP_HTTP_PORT=80
APP_MAIL_DOMAIN=@nossacasa.app
APP_USER_SYSTEM=system
APP_USER_SYSTEM_EMAIL=system${APP_MAIL_DOMAIN}
APP_USER_SYSTEM_PASSWORD=password

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR
APP_LOCALES=en,pt,es

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=secret

DOCKER_DB_DATABASE=laravel
DOCKER_DB_USERNAME=root
DOCKER_DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=nossa-casa
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=${APP_HTTP_DOMAIN},localhost
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
# Use the public HTTPS host and port 443 in production so Echo connects with WSS.
VITE_REVERB_HOST=${APP_HTTP_DOMAIN}
VITE_REVERB_PORT=${APP_HTTP_PORT}
VITE_REVERB_SCHEME=http
FILESYSTEM_DISK=local
FILESYSTEM_METADATA_DISKS=
QUEUE_CONNECTION=database
MEDIA_DISK=media
MEDIA_ARCHIVE_DISK=recordings
DOCKER_MEDIA_DISK=minio
DOCKER_MEDIA_ARCHIVE_DISK=minio
MEDIA_NODE_ROLE=core
MEDIA_WORKER_ID=media-worker-1
MEDIA_WORKER_TOKEN=
# MEDIA_RECORDINGS_PATH=/recordings
MEDIAMTX_API_URL=http://mediamtx:9997
# Usada com docker-compose.core.yml; aponte para o IP privado/VPN do nó remoto.
REMOTE_MEDIAMTX_API_URL=http://host.docker.internal:9997
MEDIAMTX_API_TOKEN=
MEDIAMTX_PUBLIC_WEBRTC_URL=${APP_URL}/webrtc
MEDIAMTX_WEBRTC_UDP_PORT=8189
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=localhost
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_PUBLIC_RTMP_URL=rtmp://${APP_HTTP_DOMAIN}:${MEDIAMTX_RTMP_PORT}
MEDIAMTX_CONNECT_TIMEOUT=3
MEDIAMTX_TIMEOUT=10
MEDIAMTX_RECORD_SEGMENT_DURATION=15m

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_TEMPORARY_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set MEDIA_DISK and/or MEDIA_ARCHIVE_DISK to one of the disks below.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY_ID=${MINIO_ROOT_USER}
MINIO_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=nossa-casa
MINIO_URL=${APP_URL}/${MINIO_BUCKET}
MINIO_TEMPORARY_URL=${APP_URL}
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true
MINIO_CONSOLE_PORT=9001

MEGA_S4_ACCESS_KEY_ID=
MEGA_S4_SECRET_ACCESS_KEY=
MEGA_S4_DEFAULT_REGION=eu-amsterdam
MEGA_S4_BUCKET=
MEGA_S4_URL=
MEGA_S4_TEMPORARY_URL=
MEGA_S4_ENDPOINT=https://s3.eu-amsterdam.megas4.com
MEGA_S4_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLOUD_HMAC_ACCESS_KEY_ID=
GOOGLE_CLOUD_HMAC_SECRET_ACCESS_KEY=
GOOGLE_CLOUD_DEFAULT_REGION=auto
GOOGLE_CLOUD_BUCKET=
GOOGLE_CLOUD_URL=
GOOGLE_CLOUD_TEMPORARY_URL=
GOOGLE_CLOUD_ENDPOINT=https://storage.googleapis.com
GOOGLE_CLOUD_USE_PATH_STYLE_ENDPOINT=true

AKAMAI_ACCESS_KEY_ID=
AKAMAI_SECRET_ACCESS_KEY=
AKAMAI_DEFAULT_REGION=us-east-1
AKAMAI_BUCKET=
AKAMAI_URL=
AKAMAI_TEMPORARY_URL=
AKAMAI_ENDPOINT=
AKAMAI_USE_PATH_STYLE_ENDPOINT=false

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=
AZURE_STORAGE_TEMPORARY_URL=
AZURE_STORAGE_PUBLIC=false

VITE_APP_NAME="${APP_NAME}"

BIBLE_API_CDN_URL=https://cdn.jsdelivr.net/gh/wldeh/bible-api/bibles
BIBLE_API_CONTENTS_URL=https://api.github.com/repos/wldeh/bible-api/contents/bibles
BIBLE_API_TIMEOUT=10
BIBLE_API_CACHE_TTL=86400
BIBLE_DEFAULT_VERSIONS=pt-BR-blt,en-kjv

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="${APP_URL}"

OPENAI_TOKEN=""
OPENROUTER_TOKEN=""
GEMINI_TOKEN=""
