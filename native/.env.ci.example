# Safe, versioned template for NativePHP builds in CI.
# Never put real signing passwords, certificates, API keys or service-account
# contents in this file. GitHub Actions injects those values from Secrets.

APP_NAME="Nossa Casa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

NATIVEPHP_APP_ID=br.org.nossacasa.app
NATIVEPHP_APP_VERSION=0.0.0
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_DEEPLINK_SCHEME=nossacasa
NATIVEPHP_START_URL=/
NATIVEPHP_RUNTIME_MODE=persistent
NOSSA_CASA_DEFAULT_SERVER=https://nossacasa.app

# Paths and scalar credentials below are injected by GitHub Actions. For local
# signed builds, copy this file to .env and fill them only in the untracked .env.
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

NATIVEPHP_DEVELOPMENT_TEAM=
IOS_TEAM_ID=
IOS_DISTRIBUTION_CERTIFICATE_PATH=
IOS_DISTRIBUTION_CERTIFICATE_PASSWORD=
IOS_DISTRIBUTION_PROVISIONING_PROFILE_PATH=
APP_STORE_API_KEY_PATH=
APP_STORE_API_KEY_ID=
APP_STORE_API_ISSUER_ID=
