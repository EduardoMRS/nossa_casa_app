APP_NAME="Nossa Casa Media Node"
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=http://media-webhook:8000
LOG_CHANNEL=stderr

DB_CONNECTION=sqlite
DB_DATABASE=/state/database.sqlite
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3660
CACHE_STORE=file
SESSION_DRIVER=file

MEDIA_NODE_ROLE=node
MEDIA_WORKER_ID=media-node-1
MEDIA_WORKER_TOKEN=CHANGE_FOR_THE_SAME_LONG_RANDOM_TOKEN_USED_BY_CORE
MEDIA_RECORDINGS_PATH=/recordings

MEDIA_CORE_URL=https://<dominio-do-servidor-principal>
MEDIA_CORE_VERIFY_TLS=true
MEDIA_CORE_CONNECT_TIMEOUT=10
MEDIA_CORE_REQUEST_TIMEOUT=30

# O worker e o app principal devem usar o mesmo bucket e o mesmo disco lógico.
MEDIA_ARCHIVE_DISK=minio
MINIO_ACCESS_KEY_ID=CHANGE_ME
MINIO_SECRET_ACCESS_KEY=CHANGE_ME
MINIO_DEFAULT_REGION=us-east-1
MINIO_BUCKET=nossa-casa
MINIO_ENDPOINT=http://<ip-da-maquina-de-arquivos>:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true

# Use o IP privado/VPN do nó. Não publique a porta 9997 na internet.
MEDIA_API_BIND_IP=<ip-privado-desta-maquina-de-midia>
MEDIAMTX_API_PORT=9997
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_UDP_PORT=8189
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=<dominio-ou-ip-publico-deste-no>
MEDIAMTX_RTMP_PORT=1935

SKIP_NODE_INSTALL=true
