APP_NAME="Nossa Casa Media Node"
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=http://media-relay:8000
LOG_CHANNEL=stderr

DB_CONNECTION=sqlite
DB_DATABASE=/state/database.sqlite
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file

MEDIA_NODE_ROLE=relay
MEDIA_WORKER_ID=media-node-1
MEDIA_WORKER_TOKEN=CHANGE_FOR_THE_SAME_LONG_RANDOM_TOKEN_USED_BY_CORE
MEDIA_RECORDINGS_PATH=/recordings

MEDIA_CORE_URL=https://app.example.com
MEDIA_CORE_VERIFY_TLS=true
MEDIA_CORE_CONNECT_TIMEOUT=10
MEDIA_CORE_UPLOAD_TIMEOUT=3600

# Bind the control API only to the machine's private VPN address.
MEDIA_API_BIND_IP=127.0.0.1

SKIP_NODE_INSTALL=true
